ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

# Build tool only (glslc, headers, import library); nothing from it ships.
VULKAN_SDK_VERSION=1.4.363.0
