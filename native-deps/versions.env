# Pinned sources for the native-deps workflow (ADR 0002).
# Sourced by the scripts in this folder; keep it plain KEY=value.
# Tarballs are pinned by our own SHA-256, git sources by commit.

WHISPER_CPP_TAG=v1.9.4
WHISPER_CPP_COMMIT=927cfce34f31707e17f2bff35c349632fb9e2c3a
WHISPER_CPP_REPO=https://github.com/ggml-org/whisper.cpp.git

FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e

# x264 publishes no release tarballs; this is the head of its stable branch.
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55
X264_REPO=https://code.videolan.org/videolan/x264.git

X265_VERSION=4.2
X265_URL=https://download.videolan.org/videolan/x265/x265_4.2.tar.gz
X265_SHA256=40b1ea0453e0309f0eba934e0ddf533f8f6295966679e8894e8f1c1c8d5e1210

ZLIB_VERSION=1.3.2
