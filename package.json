{
  "name": "motionbrief",
  "productName": "MotionBrief",
  "version": "0.0.0",
  "private": true,
  "description": "An agentic video editor: turns a spoken recording into a motion-graphics YouTube video.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.web.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "contact-sheet": "vitest run --config vitest.run.config.ts contact-sheet",
    "spike-check": "vitest run --config vitest.run.config.ts spike-check",
    "postinstall": "node scripts/deps/postinstall.ts",
    "deps:fetch": "node scripts/deps/postinstall.ts",
    "deps:pin": "node scripts/deps/pin.ts",
    "eval": "node scripts/eval.ts",
    "package": "electron-vite build && node scripts/release/licenses.ts && electron-builder --publish never",
    "package:smoke": "node scripts/release/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@hyperframes/producer": "0.8.113",
    "@orpc/client": "1.15.4",
    "@orpc/contract": "1.15.4",
    "@orpc/server": "1.15.4",
    "electron-updater": "6.8.9",
    "gsap": "3.15.0",
    "hyperframes": "0.8.113",
    "lucide-static": "1.49.0",
    "puppeteer-core": "25.12.0",
    "simple-icons": "16.33.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@hyperframes/player": "0.8.113",
    "@orpc/tanstack-query": "1.15.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "lucide-react": "1.49.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zustand": "5.0.15"
  }
}
